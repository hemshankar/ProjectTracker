# Shared secret with the backend (set the same value as ACCOUNTING_SERVICE_KEY in backend/.env).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ACCOUNTING_SERVICE_KEY=replace-me
# Ideally a dedicated Mongo instance; back it up (NFR-10).
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=scatterboard_accounting
MAX_BATCH_SIZE=500
# Read-side bounds (defaults shown).
MAX_QUERY_RANGE_DAYS=400
MAX_PAGE_SIZE=500
EXPORT_CHUNK_SIZE=1000
