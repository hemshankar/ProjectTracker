# Secrets live only on this service — never pass them to the monolith or frontend.
# Shared secret with the monolith (set the same value in backend/.env).
INTERNAL_SERVICE_KEY=replace-with-output-of-python-secrets-token_hex-32

# Composio project API key (Phase 3 moves these into the admin UI).
COMPOSIO_API_KEY=
# Scoped key with "Proxy execute" enabled. Falls back to COMPOSIO_API_KEY if empty.
COMPOSIO_PROXY_API_KEY=
# Secret of the webhook subscription pointing at https://<public-url>/webhooks/composio
COMPOSIO_WEBHOOK_SECRET=

# IANA timezone for calendar events whose times have no offset (e.g. Asia/Kolkata).
DEFAULT_TIMEZONE=UTC

# --- Admin UI (Phase 3). Generate with:  python -m app.cli hash-password   and   python -m app.cli gen-keys
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Fernet key for credentials stored via the admin UI. BACK THIS UP: losing it makes stored credentials unreadable.
SECRETS_ENCRYPTION_KEY=
