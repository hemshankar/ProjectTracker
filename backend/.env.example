MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=scatterboard
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Identity / auth (Phase 1) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
SESSION_SECRET_KEY=replace-with-output-of-python-secrets-token_hex-32
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# --- Tools & budget enforcement (Phase 5) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a dev-only key is derived from SESSION_SECRET_KEY.
TOOL_ENCRYPTION_KEY=
GOOGLE_TOOLS_REDIRECT_URI=http://localhost:3000/api/tools/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/tools/slack/callback
RATE_LIMIT_GMAIL_PER_DAY=50
RATE_LIMIT_CALENDAR_PER_DAY=50
RATE_LIMIT_SLACK_PER_DAY=200
GLOBAL_BUDGET_CAP_USD=
ANTHROPIC_INPUT_COST_PER_MTOK=3.0
ANTHROPIC_OUTPUT_COST_PER_MTOK=15.0
